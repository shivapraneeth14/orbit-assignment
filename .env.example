# ORBIT — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env

# PostgreSQL connection string (Supabase or Neon)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=""

# Auth.js Secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# URL of your deployed app (or http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"

# Required for authenticated requests made through Vercel's proxy/CDN
AUTH_TRUST_HOST="true"

# Optional: set to a shared URL signing secret for invite links
# INVITE_SECRET=""