# ORBIT — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env

# PostgreSQL connection string (Neon, Supabase, etc.)
# Runtime/app use:  pooled URL  (Neon: host has "-pooler" in it)
DATABASE_URL=""

# Prisma CLI (migrations, seed) use the DIRECT/unpooled URL to bypass PgBouncer.
# On Neon, both strings come from the dashboard / `neon env pull` and already
# carry `?sslmode=require`. For local Postgres dev you can omit this and the
# CLI falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Auth.js Secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# URL of your deployed app (or http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"

# Required for authenticated requests made through Vercel's proxy/CDN
AUTH_TRUST_HOST="true"

# Optional: set to a shared URL signing secret for invite links
# INVITE_SECRET=""